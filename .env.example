# Copy to .env and fill in the values you need. All variables are optional.
#
# Server
PORT=8081
HOST=0.0.0.0
# Restrict cross-origin calls/Socket.IO to your frontend origin (default: *)
CORS_ORIGIN=https://khanhlx6.github.io

# TikTok connection
# Optional Euler Stream API key (https://www.eulerstream.com/) for higher reliability
API_KEY=
# Optional TikTok session cookie (may help with some regions / private rooms)
SESSIONID=

# Abuse protection: set to 1 to enable per-IP connection limiting
ENABLE_RATE_LIMIT=1

# Optional Google reCAPTCHA v2 (leave empty to disable captcha entirely)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
